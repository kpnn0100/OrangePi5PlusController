#!/bin/bash
# Arstro Remote startup script for one slot (A/B instance, see install.sh).
#
#   ARSTRO_SLOT=b arstro-remote-launcher      (the autostart entry / systemd unit sets it)
#
# Started from the desktop session's autostart (or a systemd user unit on machines without
# a desktop) so the daemon gets polkit "active session" rights for NetworkManager and the
# X display for the remote screen / input. The loop restarts the daemon whenever it exits
# (crash, update, `system.restart`), with a growing delay if it keeps failing.

SLOT="${ARSTRO_SLOT:-}"
[ "${1:-}" = "--slot" ] && SLOT="$2"
if [ -n "$SLOT" ]; then
    NAME="arstro-remote-$SLOT"
    export ARSTRO_SLOT="$SLOT"
else
    NAME="arstro-remote"
fi
APP_DIR="${ARSTRO_APP_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/$NAME}"
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/$NAME"
RUN_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
LOG="$LOG_DIR/launcher.log"

mkdir -p "$LOG_DIR"
exec 9<>"$RUN_DIR/$NAME-launcher.lock"
if ! flock -n 9; then
    echo "$NAME launcher is already running" >&2
    exit 0
fi
: >"$RUN_DIR/$NAME-launcher.lock"
echo $$ >&9                       # install.sh reads the launcher's pid from here

# Keep the launcher log small (the daemon has its own rotating log).
if [ -f "$LOG" ] && [ "$(stat -c %s "$LOG")" -gt 1000000 ]; then
    mv -f "$LOG" "$LOG.1"
fi

export DISPLAY="${DISPLAY:-:0}"
[ -z "${XAUTHORITY:-}" ] && [ -f "$HOME/.Xauthority" ] && export XAUTHORITY="$HOME/.Xauthority"
export PYTHONPATH="$APP_DIR${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONUNBUFFERED=1

log() { echo "$(date '+%F %T') $*" >>"$LOG"; }

trap 'log "launcher stopping"; kill "$child" 2>/dev/null; wait "$child" 2>/dev/null; exit 0' TERM INT HUP

log "launcher started (slot ${SLOT:-none}, pid $$, code $APP_DIR, DISPLAY=$DISPLAY, session ${XDG_SESSION_ID:-?})"
delay=2
while true; do
    started=$(date +%s)
    python3 -m arstro_remote ${SLOT:+--slot "$SLOT"} run 9>&- >>"$LOG" 2>&1 &
    child=$!
    wait "$child"
    code=$?
    ran=$(( $(date +%s) - started ))
    if [ "$ran" -gt 60 ]; then delay=2; else delay=$(( delay * 2 > 30 ? 30 : delay * 2 )); fi
    [ "$code" = 0 ] && delay=1            # a requested restart: come back quickly
    log "daemon exited (code $code after ${ran}s), restarting in ${delay}s"
    sleep "$delay"
done
