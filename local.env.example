# Copy to local.env (gitignored) and fill in what you use. Read by scripts/setup_all.sh.
# Nothing machine-specific belongs in the repo itself (ARC-05).

# The Pi: user@host (address or mDNS name)
ARSTRO_PI=orangepi@orangepi5plus.local
# ARSTRO_PI_PORT=22

# Android device for --install (see `adb devices`)
# ANDROID_SERIAL=

# Web / remote-CLI password to set with --web-password. Leave it out to be asked instead.
# ARSTRO_WEB_PASS=
