# Copy to .env and fill in. ./run.sh and docker compose read it.

# The domain the device manager is reached at (https://DOMAIN/arstro/internal/devices/).
DOMAIN=devices.example.com

# Who does HTTPS:
#   caddy - this kit (Caddy gets the certificate; DOMAIN must point here, ports 80 and 443 open)
#   own   - a proxy you already run (e.g. nginx on 443): only the device manager starts, on
#           RELAY_LISTEN, and ports 80/443 are left alone
PROXY=caddy

# PROXY=own: where the device manager listens for your proxy. 127.0.0.1:8090 when the proxy runs
# directly on this server; 0.0.0.0:8090 when it runs in Docker or on another server (then keep the
# port closed to the internet - on Oracle Cloud the security list does that unless you open it).
#RELAY_LISTEN=127.0.0.1:8090

# Optional: a password for the device list (empty = the list is visible, the machines still
# need their own access keys).
RELAY_PASSWORD=

# Optional: the path the device manager lives under (default /arstro/internal/devices).
#RELAY_BASE=/arstro/internal/devices

# Optional: a fixed join token instead of the generated one (./run.sh token shows it).
#RELAY_JOIN_TOKEN=
